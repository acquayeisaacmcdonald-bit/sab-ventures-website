import io, re

with io.open('index.html', 'r', encoding='utf-8') as f:
    html = f.read()

pattern = re.compile(
    r"\s*<script>\s*\(function \(\) \{\s*const slides = document\.querySelectorAll\('#heroSlideshow[^<]*?</script>",
    re.DOTALL
)

matches = pattern.findall(html)
print("Found", len(matches), "slideshow script block(s)")

if len(matches) > 1:
    first = matches[0]
    html = pattern.sub('%%KEEP%%', html)
    html = html.replace('%%KEEP%%', first, 1)
    html = html.replace('%%KEEP%%', '')
    print("Removed", len(matches) - 1, "duplicate(s)")
elif len(matches) == 1:
    print("Only one — nothing to remove")
else:
    print("No matching blocks found")

with io.open('index.html', 'w', encoding='utf-8') as f:
    f.write(html)

print("Done.")